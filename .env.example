# Copiar a .env. No commitear .env.

# Conexión directa a Postgres (local o Prisma Postgres / migrate).
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/talksportuarios"

# Opcional. En Vercel: URL con pooler. La app usa DATABASE_URL_POOLED si existe.
# DATABASE_URL_POOLED=""

# Auth.js (sesión JWT del panel). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Solo para `npx prisma db seed` (no hace falta en Vercel si la BD ya tiene el admin).
ADMIN_EMAIL=""
ADMIN_NOMBRE=""
ADMIN_PASSWORD=""
